msgid "File Roller"
msgstr "File Roller"

#: data/org.gnome.FileRoller.desktop.in.in:3
msgid "Archive Manager"
msgstr "Arkivhandsamar"

#: data/org.gnome.FileRoller.desktop.in.in:4
msgid "Create and modify an archive"
msgstr "Lag og endre arkiv"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.gnome.FileRoller.desktop.in.in:6
msgid "zip;tar;extract;unpack;"
msgstr "zip;tar;extract;unpack;pakk ut;trekk ut;arkiv;"

#: data/org.gnome.FileRoller.gschema.xml:58
msgid "How to sort files"
msgstr "Korleis filene skal sorterast"

#: data/org.gnome.FileRoller.gschema.xml:59
msgid ""
"What criteria must be used to arrange files. Possible values: name, size, "
"type, time, path."
msgstr ""
"Kva kriterium som skal brukast til å ordne filene. Moglege verdiar: name, "
"size, type, time, path."

#: data/org.gnome.FileRoller.gschema.xml:63
msgid "Sort type"
msgstr "Sorteringsrekkjefølgje"

#: data/org.gnome.FileRoller.gschema.xml:64
msgid ""
"Whether to sort in ascending or descending direction. Possible values: "
"ascending, descending."
msgstr ""
"Om det skal sorterast stigande eller søkkande. Moglege verdiar: ascending, "
"descending."

#: data/org.gnome.FileRoller.gschema.xml:68
msgid "List Mode"
msgstr "Listemodus"

#: data/org.gnome.FileRoller.gschema.xml:69
msgid ""
"Use “all-files” to view all the files in the archive in a single list, use "
"“as-folder” to navigate the archive as a folder."
msgstr ""
"Bruk «all-files» for å sjå alle filene i arkivet i ei enkelt liste, og «as-"
"folder» for å navigere i arkivet som i ei mappe."

#: data/org.gnome.FileRoller.gschema.xml:73
msgid "Display type"
msgstr "Vis type"

#: data/org.gnome.FileRoller.gschema.xml:74
msgid "Display the type column in the main window."
msgstr "Vis typekolonnen i hovudvindauget."

#: data/org.gnome.FileRoller.gschema.xml:78
msgid "Display size"
msgstr "Vis storleik"

#: data/org.gnome.FileRoller.gschema.xml:79
msgid "Display the size column in the main window."
msgstr "Vis storleikskolonnen i hovudvindauget."

#: data/org.gnome.FileRoller.gschema.xml:83
msgid "Display time"
msgstr "Vis tid"

#: data/org.gnome.FileRoller.gschema.xml:84
msgid "Display the time column in the main window."
msgstr "Vis tidskolonnen i hovudvindauget."

#: data/org.gnome.FileRoller.gschema.xml:88
msgid "Display path"
msgstr "Vis sti"

#: data/org.gnome.FileRoller.gschema.xml:89
msgid "Display the path column in the main window."
msgstr "Vis stikolonnen i hovudvindauget."

#: data/org.gnome.FileRoller.gschema.xml:93
msgid "Name column width"
msgstr "Breidd på namnekolonnen"

#: data/org.gnome.FileRoller.gschema.xml:94
msgid "The default width of the name column in the file list."
msgstr "Standardbreidda på namnekolonnen i fillista."

#: data/org.gnome.FileRoller.gschema.xml:110
msgid "View the sidebar"
msgstr "Vis sidefeltet"

#: data/org.gnome.FileRoller.gschema.xml:111
msgid "Whether to display the sidebar."
msgstr "Om sidefeltet skal visast."

#: data/org.gnome.FileRoller.gschema.xml:136
msgid "Editors"
msgstr "Redigeringsprogram"

#: data/org.gnome.FileRoller.gschema.xml:137
msgid ""
"List of applications entered in the “Open File” dialog and not associated "
"with the file type."
msgstr ""
"Liste over program som er skrivne inn i dialogvindauget «Opne fil» og ikkje "
"er knytte til filtypen."

#: data/org.gnome.FileRoller.gschema.xml:141
msgid "Compression level"
msgstr "Komprimeringsnivå"

#: data/org.gnome.FileRoller.gschema.xml:142
msgid ""
"Compression level used when adding files to an archive. Possible values: "
"very-fast, fast, normal, maximum."
msgstr ""
"Komprimeringsnivået som vert brukt når filer vert lagde til i eit arkiv. "
"Moglege verdiar: very-fast, fast, normal, maximum."

#: data/org.gnome.FileRoller.gschema.xml:146
#: data/org.gnome.FileRoller.gschema.xml:184
msgid "Encrypt the archive header"
msgstr "Krypter arkivhovudet"

#: data/org.gnome.FileRoller.gschema.xml:147
#: data/org.gnome.FileRoller.gschema.xml:185
msgid ""
"Whether to encrypt the archive header. If the header is encrypted the "
"password will be required to list the archive content as well."
msgstr ""
"Om arkivhovudet skal krypterast. Er hovudet kryptert, trengst passordet òg "
"for å liste opp innhaldet i arkivet."

# TRN: Denne bør omformast
#: data/org.gnome.FileRoller.gschema.xml:161
msgid "Do not overwrite newer files"
msgstr "Ikkje overskriv nyare filer"

#: data/org.gnome.FileRoller.gschema.xml:165
msgid "Recreate the folders stored in the archive"
msgstr "Lag mappene som er lagra i arkivet, på nytt"

#: data/org.gnome.FileRoller.gschema.xml:189
msgid "Show/hide the extra options"
msgstr "Vis/gøym dei ekstra vala"

#: data/org.gnome.FileRoller.gschema.xml:190
msgid "Whether to show other options. If set the extra options will be shown."
msgstr ""
"Om andre val skal visast. Er dette slått på, vert dei ekstra vala viste."

#: data/org.gnome.FileRoller.gschema.xml:194
msgid "Default volume size"
msgstr "Standardstorleik på delarkiv"

#: data/org.gnome.FileRoller.gschema.xml:195
msgid "The default size for volumes."
msgstr "Standardstorleiken på delarkiv."

#: data/org.gnome.FileRoller.metainfo.xml.in:10
msgid "Open, modify and create compressed archive files"
msgstr "Opne, endre og lage komprimerte arkivfiler"

#: data/org.gnome.FileRoller.metainfo.xml.in:12
msgid ""
"File Roller is a GNOME application for opening, creating, and modifying "
"archive and compressed archive files."
msgstr ""
"File Roller er eit GNOME-program for å opne, lage og endre arkiv og "
"komprimerte arkivfiler."

#: data/org.gnome.FileRoller.metainfo.xml.in:16
msgid ""
"File Roller supports a wide range of different archive files, including:"
msgstr "File Roller støttar mange ulike arkivfiler, mellom anna:"

#: data/org.gnome.FileRoller.metainfo.xml.in:20
msgid "gzip archives (.tar.gz, .tgz)"
msgstr "gzip-arkiv (.tar.gz, .tgz)"

#: data/org.gnome.FileRoller.metainfo.xml.in:21
msgid "bzip archives (.tar.bz, .tbz)"
msgstr "bzip-arkiv (.tar.bz, .tbz)"

#: data/org.gnome.FileRoller.metainfo.xml.in:22
msgid "zip archives (.zip)"
msgstr "zip-arkiv (.zip)"

#: data/org.gnome.FileRoller.metainfo.xml.in:23
msgid "xz archives (.tar.xz)"
msgstr "xz-arkiv (.tar.xz)"

#: data/org.gnome.FileRoller.metainfo.xml.in:36
msgid "File Roller's main interface"
msgstr "Hovudvindauget i File Roller"

#: nautilus/nautilus-fileroller.c:258
